digraph G {
    node [shape=box, style=filled, color=lightblue];
    
    subgraph cluster_frontend {
        label = "Frontend (React)";
        Dashboard [label="Real-time Dashboard"];
        AccountMgr [label="Account Manager"];
        PipelineConfig [label="Pipeline Config"];
    }
    
    subgraph cluster_backend {
        label = "Backend (FastAPI)";
        API [label="REST API"];
        WorkerManager [label="Worker Manager (Async)"];
        DB [(SQLite DB)];
    }
    
    Dashboard -> API [label="WebSockets/Poll"];
    AccountMgr -> API;
    PipelineConfig -> API;
    
    API -> DB;
    API -> WorkerManager [label="Start/Stop Pipeline"];
    WorkerManager -> Orchestrator [label="Execute Steps"];
    Orchestrator -> WP [label="Post"];
    Orchestrator -> FB [label="Post"];
    Orchestrator -> AI [label="Generate"];
}
